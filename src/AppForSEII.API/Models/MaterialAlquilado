using System.ComponentModel.DataAnnotations;


namespace AppForSEII.API.Models;

public class MaterialAlquilado
{

    public int IdAlquiler { get; set; }
    public int IdMaterial { get; set; }

    public int Cantidad { get; set; }
    public int Precio { get; set; }

    public string? Descripcion { get; set; }


    [Required]
    public string? Descripcion {get; set;}

    public string? NombreTipoMaterial {get;set;}

    public MaterialAlquilado(){}

    public MaterialAlquilado(int idMaterial, int idAlquiler, int cantidad, int precio, string? descripcion)
    {
        IdMaterial = idMaterial;
        IdAlquiler = idAlquiler;
        Cantidad = cantidad;
        Precio = precio;
        Descripcion = descripcion;
    }
    



    public override bool Equals(object? otro)
    { 
        if (otro == null) return false;
        if (otro.GetType() != this.GetType()) return false; 
        
        MaterialAlquilado otro_material_alquilado = (MaterialAlquilado) otro;

        if (otro_material_alquilado.IdMaterial != this.IdMaterial) return false;
        return true;
    }

    public override int GetHashCode()
    {
        return IdMaterial.GetHashCode();
    }
}