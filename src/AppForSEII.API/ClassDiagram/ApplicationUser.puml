@startuml
class ApplicationUser {
    + ApplicationUser()
    + ApplicationUser(name:string, surname:string, dni:string, age:int, sex:string, userName:string, email:string, phoneNumber:string)
    + Name : string <<get>> <<set>>
    + Surname : string <<get>> <<set>>
    + DNI : string <<get>> <<set>>
    + Age : int <<get>> <<set>>
    + Sex : string <<get>> <<set>>
    + <<override>> Equals(otro:object?) : bool
    + <<override>> GetHashCode() : int
}
IdentityUser <|-- ApplicationUser
@enduml
