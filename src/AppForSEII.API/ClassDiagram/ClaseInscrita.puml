@startuml
class ClaseInscrita {
    + ClaseInscrita()
    + ClaseInscrita(claseDeportivaId:int, inscripcionId:int, plazasReservadas:int, precio:decimal, observaciones:string?)
    + Id : int <<get>> <<set>>
    + ClaseDeportivaId : int <<get>> <<set>>
    + ClaseDeportiva : ClaseDeportiva? <<get>> <<set>>
    + InscripcionId : int <<get>> <<set>>
    + Inscripcion : Inscripcion? <<get>> <<set>>
    + PlazasReservadas : int <<get>> <<set>>
    + Precio : decimal <<get>> <<set>>
    + Observaciones : string? <<get>> <<set>>
