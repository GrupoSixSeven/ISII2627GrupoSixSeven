@startuml
class ClaseDeportiva {
    + ClaseDeportiva()
    + ClaseDeportiva(descripcion:string, fechaHora:DateTime, lugar:string, monitor:string, nivel:string, plazasDisponibles:int, precioUnitario:decimal, tipoDeporte:TipoDeporte)
    + Id : int <<get>> <<set>>
    + <<required>> Descripcion : string <<get>> <<set>>
    + <<required>> FechaHora : DateTime <<get>> <<set>>
    + <<required>> Lugar : string <<get>> <<set>>
    + <<required>> Monitor : string <<get>> <<set>>
    + <<required>> Nivel : string <<get>> <<set>>
    + PlazasDisponibles : int <<get>> <<set>>
    + PrecioUnitario : decimal <<get>> <<set>>
    + TipoDeporteId : int <<get>> <<set>>
    + TipoDeporte : TipoDeporte? <<get>> <<set>>
    + ClasesInscritas : IList<ClaseInscrita> <<get>> <<set>>
    + <<override>> Equals(otro:object?) : bool
    + <<override>> GetHashCode() : int
}
@enduml
