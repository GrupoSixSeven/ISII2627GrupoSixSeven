using AppForSEII.API.Controllers;
using AppForSEII.API.Data;
using AppForSEII.API.DTOs.CompeticionDTOs;
using AppForSEII.API.Models;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;
using Moq;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Xunit;

namespace AppForSEII.UT.InscripcionController_test
{
    public class PostInscripcion_test : AppForSEII4SqliteUT
    {
        private const string _userName = "Alejandro.Gonzalez52@uclm.es";
        private const string _name = "Alejandro";
        private const string _surname = "González Sánchez";
        private const string _dni = "12345678A";
        private const string _phone = "666555444";
        private const string _datosPago = "1234-5678-9012-3456";
        private static readonly DateTime _fechaCompeticion = new DateTime(2026, 12, 10, 10, 0, 0);

        public PostInscripcion_test()
        {
            var tipoDeporte = new TipoDeporte { Id = 1, Nombre = "Tenis", NombreTipoDeporte = "Competiciones", Descripcion = "" };

            var competiciones = new List<Competicion>()
            {
                new Competicion { Id = 1, Nombre = "Torneo de tenis", TipoDeporte = tipoDeporte, Fecha = _fechaCompeticion, Lugar = "Ciudad Real", Precio = 15m, Plazas = 10 },
                new Competicion { Id = 2, Nombre = "Open de tenis", TipoDeporte = tipoDeporte, Fecha = _fechaCompeticion, Lugar = "Toledo", Precio = 20m, Plazas = 0 }
            };

            var user = new ApplicationUser {
                Id = "1", Name = _name, Surname = _surname,
                Email = _userName, DNI = _dni, PhoneNumber = _phone, UserName = _userName
            };

            _context.ApplicationUsers.Add(user);
            _context.Add(tipoDeporte);
            _context.AddRange(competiciones);
            _context.SaveChanges();
        }

        public static IEnumerable<object[]> TestCasesFor_CreateInscripcion()
        {
            var validItem = new CompeticionItemDTO(1, "Torneo de tenis", "Tenis", _fechaCompeticion, 15m, "Ok");
            var validItemsList = new List<CompeticionItemDTO> { validItem };

            var inscripcionFechaPasada = new InscripcionForCreateDTO(_name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta, validItemsList, _datosPago, DateTime.Today.AddDays(-1));
            var inscripcionSinCompeticiones = new InscripcionForCreateDTO(_name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta, new List<CompeticionItemDTO>(), _datosPago, DateTime.Today);
            var inscripcionCompeticionRepetida = new InscripcionForCreateDTO(_name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta,
                new List<CompeticionItemDTO> { validItem, validItem }, _datosPago, DateTime.Today);
            var inscripcionUsuarioFalso = new InscripcionForCreateDTO(_name, _surname, _dni, "falso@uclm.es", _phone, MetodoPago.Tarjeta, validItemsList, _datosPago, DateTime.Today);
            var inscripcionSinPlazas = new InscripcionForCreateDTO(_name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta,
                new List<CompeticionItemDTO> { new CompeticionItemDTO(2, "Open de tenis", "Tenis", _fechaCompeticion, 20m, "") }, _datosPago, DateTime.Today);
            var inscripcionCompeticionNoExiste = new InscripcionForCreateDTO(_name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta,
                new List<CompeticionItemDTO> { new CompeticionItemDTO(99, "Inexistente", "Tenis", _fechaCompeticion, 10m, "") }, _datosPago, DateTime.Today);

            var allTests = new List<object[]>
            {
                new object[] { inscripcionFechaPasada, "Error! La fecha de su inscripción no puede ser anterior a hoy" },
                new object[] { inscripcionSinCompeticiones, "Error! Debe incluir al menos una competición para inscribirse" },
                new object[] { inscripcionCompeticionRepetida, "Error! Hay competiciones repetidas en el carrito" },
                new object[] { inscripcionUsuarioFalso, "Error! No hay ningún usuario registrado con ese email" },
                new object[] { inscripcionSinPlazas, "Error! La competición con id '2' no tiene plazas disponibles" },
                new object[] { inscripcionCompeticionNoExiste, "Error! La competición con id '99' no tiene plazas disponibles" }
            };

            return allTests;
        }

        [Theory]
        [Trait("LevelTesting", "Unit Testing")]
        [Trait("Database", "WithoutFixture")]
        [MemberData(nameof(TestCasesFor_CreateInscripcion))]
        public async Task CreateInscripcion_Error_test(InscripcionForCreateDTO inscripcionDTO, string errorExpected)
        {
            var mock = new Mock<ILogger<InscripcionController>>();
            var controller = new InscripcionController(_context, mock.Object);

            var result = await controller.CreateInscripcion(inscripcionDTO);

            var badRequestResult = Assert.IsType<BadRequestObjectResult>(result);
            var problemDetails = Assert.IsType<ValidationProblemDetails>(badRequestResult.Value);
            var errorActual = problemDetails.Errors.First().Value[0];

            Assert.StartsWith(errorExpected, errorActual);
        }

        [Fact]
        [Trait("LevelTesting", "Unit Testing")]
        [Trait("Database", "WithoutFixture")]
        public async Task CreateInscripcion_Success_test()
        {
            var mock = new Mock<ILogger<InscripcionController>>();
            var controller = new InscripcionController(_context, mock.Object);

            var inscripcionDTO = new InscripcionForCreateDTO(_name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta,
                new List<CompeticionItemDTO> { new CompeticionItemDTO(1, "Torneo de tenis", "Tenis", _fechaCompeticion, 15m, "Ok") }, _datosPago, DateTime.Today);

            var expectedInscripcionDetailDTO = new InscripcionDetailDTO(
                1, _name, _surname, _dni, _userName, _phone, MetodoPago.Tarjeta,
                new List<CompeticionItemDTO> { new CompeticionItemDTO(1, "Torneo de tenis", "Tenis", _fechaCompeticion, 15m, "Ok") },
                _datosPago, DateTime.Today);

            var result = await controller.CreateInscripcion(inscripcionDTO);

            var createdResult = Assert.IsType<CreatedAtActionResult>(result);
            var actualInscripcionDetailDTO = Assert.IsType<InscripcionDetailDTO>(createdResult.Value);

            Assert.Equal(expectedInscripcionDetailDTO, actualInscripcionDetailDTO);
        }
    }
}